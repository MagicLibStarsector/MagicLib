# The filename matches an id in `magic_paintjobs.csv`.
# All fields are optional.
# More info: https://starsector.wiki.gg/wiki/MagicLib#Engines_and_Shields
{
  "engines":{
    "color":[0,0,0,0], # Engine color in combat layer.
    "campaignColor"[0,0,0,0], # Engine color in campaign layer. (defaults to 'color' if unset)
    "glowAlternateColor":[0,0,0,0], # Engine glow in combat
    "glowSizeMult": 1,
    "contrailColor":[0,0,0,25], # Contrail color in combat layer.
    "contrailCampaignColor":[0,0,0,75] # Contrail color in campaign layer. (defaults to 'contrailColor' if unset)
    "contrailSpawnDistMult":1,
    "contrailWidthMultiplier":1,
  },
  "shield":{
    "innerColor":[0,0,0,0],
    "ringColor":[0,0,0,0],
    "innerRotationRate":1,
    "ringRotationRate":1
  },
  "vents":{
    "ventCoreColor":[0,0,0,0],
    "ventFringeColor":[0,0,0,0]
  }
}
